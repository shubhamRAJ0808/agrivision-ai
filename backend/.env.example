# Copy this file to  backend/.env  and fill in your values.  NEVER commit .env or share it.

# Free key from https://aistudio.google.com/apikey  (powers Farm Assistant, live market prices, photo second opinion)
GEMINI_API_KEY=PASTE_YOUR_KEY_HERE

# Gemini model used by Farm Assistant
# GEMINI_MODEL=gemini-3.8-flash

# Strongly recommended: any long random string, used to sign login tokens
AGRIVISION_SECRET_KEY=change-me-to-a-long-random-string
